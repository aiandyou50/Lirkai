{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react", "react-dom", "vite/client"],
    "outDir": "dist-ui",
    "rootDir": "src/ui",
    "composite": true
  },
  "include": ["src/ui/**/*"]
}
