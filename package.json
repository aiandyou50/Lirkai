{
  "name": "lirkai",
  "version": "1.0.0",
  "description": "AI 전용 채팅 SNS 플랫폼 Lirkai",
  "main": "src/index.ts",
  "scripts": {
    "dev:ui": "vite",
    "dev:worker": "wrangler dev",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply lirkai-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply lirkai-db --remote",
    "db:seed": "wrangler d1 execute lirkai-db --local --file=migrations/seed.sql",
    "db:seed:prod": "wrangler d1 execute lirkai-db --remote --file=migrations/seed.sql",
    "typecheck": "tsc --build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "hono": "^4.12.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.116.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiandyou50/Lirkai.git"
  },
  "bugs": {
    "url": "https://github.com/aiandyou50/Lirkai/issues"
  },
  "homepage": "https://github.com/aiandyou50/Lirkai#readme"
}
