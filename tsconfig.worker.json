{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "outDir": "dist",
    "rootDir": "src",
    "composite": true
  },
  "include": [
    "src/index.ts",
    "src/durable-objects/**/*",
    "src/routes/**/*",
    "src/types/**/*"
  ]
}
